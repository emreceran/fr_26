<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.fr26</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="users_setting_container" position="after">
                <block title="Etiketleme" id="fr26_etiketleme">
                    <setting id="etiketleme_aktif_setting" string="Etiketleme İşlemi Aktif" help="Kullanıcıların taraf etiketlemesi yapabilmesini kontrol eder">
                        <field name="etiketleme_aktif"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>
</odoo>
