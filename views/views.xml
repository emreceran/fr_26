<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_saha_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.saha.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="replace">
                <form string="Saha Müşterisi">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;image_128&quot;}"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Ad Soyad / Kurum Adı"/>
                            </h1>
                        </div>

                        <group>
                            <group string="Kurumsal Detaylar">
                                <field name="sicil_no" string="No"/>
                                <field name="rehberinde_olan_user_ids"/>

                                <field name="bolge_adi"/>

                            </group>
                        </group>

                        <group string="Saha Durumu" style="background-color: #f0f4f7; padding: 10px; border-radius: 5px;">
                            <group>
                                <field name="taraf" placeholder="Bir taraf seçiniz..." options="{'no_create': True, 'no_open': True}"/>
                            </group>
                            <group>
                                <field name="sorumlu_id" widget="many2one_avatar_user"/>
                                <field name="etiketleyen_id" readonly="1" widget="many2one_avatar_user"/>
                            </group>
                        </group>

                    </sheet>
                    <chatter/>


                </form>
            </xpath>

        </field>
    </record>

    <record id="view_partner_list_inherit_saha_final" model="ir.ui.view">
    <field name="name">res.partner.list.inherit.saha.final</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_tree"/>
    <field name="arch" type="xml">

        <field name="phone" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="email" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="user_id" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="city" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="country_id" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="vat" position="attributes"><attribute name="column_invisible">1</attribute></field>
        <field name="mobile" position="attributes"><attribute name="column_invisible">1</attribute></field>

        <field name="complete_name" position="before">
            <field name="taraf" widget="badge"
                   decoration-danger="taraf == 'kirmizi'"
                   decoration-info="taraf == 'mavi'"
                   decoration-success="taraf == 'yesil'"
                   decoration-muted="taraf == 'beyaz'"
                   string="Durum"/>
        </field>

        <field name="complete_name" position="after">
            <field name="sicil_no" optional="show"/>
        </field>

        <field name="state_id" position="replace">
            <field name="bolge_adi"
                   widget="badge"
                   decoration-info="bolge_adi == 'istanbul'"
                   decoration-success="bolge_adi == 'ankara'"
                   optional="show"/>
        </field>

        <field name="activity_ids" position="after">
            <field name="rehberinde_olan_user_ids" widget="many2many_avatar_user" string="Rehberdekiler"/>

            <field name="sorumlu_id" widget="many2one_avatar_user" string="Sorumlu" optional="hide"/>
            <field name="etiketleyen_id" widget="many2one_avatar_user" string="Etiketleyen"/>
        </field>

    </field>
</record>

   <record id="view_res_partner_filter_inherit_saha" model="ir.ui.view">
        <field name="name">res.partner.select.inherit.saha</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="after">
<!--                <field name="search_phone_input" string="Telefon No (Gizli Arama)"/>-->
                <field name="rehberinde_olan_user_ids" string="Rehber Sahibi (Personel)"/>

                <field name="sicil_no" string="Sicil No"/>
                <field name="kurum_adi" string="Kurum Adı"/>
                <field name="sorumlu_id" string="Sorumlu Personel"/>
                <field name="etiketleyen_id" string="Etiketleyen Personel"/>
            </xpath>

            <xpath expr="//filter[@name='type_person']" position="before">
                <filter string="Ankara Müşterileri" name="filter_ankara" domain="[('bolge_adi', '=', 'ankara')]"/>
                <filter string="İstanbul Müşterileri" name="filter_istanbul" domain="[('bolge_adi', '=', 'istanbul')]"/>
                <separator/>

                <filter string="Kırmızı Liste" name="filter_kirmizi" domain="[('taraf', '=', 'kirmizi')]"/>
                <filter string="Mavi Liste" name="filter_mavi" domain="[('taraf', '=', 'mavi')]"/>
                <filter string="Yeşil Liste" name="filter_yesil" domain="[('taraf', '=', 'yesil')]"/>
                <filter string="Tarafsız (Beyaz)" name="filter_beyaz" domain="[('taraf', '=', 'beyaz')]"/>
                <filter string="Atanmamış (Seçimsiz)" name="filter_atanmamis" domain="[('taraf', '=', False)]"/>
                <separator/>

                <filter string="Herhangi Bir Rehberde Olanlar" name="filter_rehber_dolu" domain="[('rehberinde_olan_user_ids', '!=', False)]"/>
                <filter string="Rehberimde Ekli Olanlar" name="filter_my_guide" domain="[('rehberinde_olan_user_ids', 'in', [uid])]"/>
                <separator/>

                <filter string="Sorumlusu Ben Olduklarım" name="my_partners" domain="[('sorumlu_id', '=', uid)]"/>
                <filter string="Etiketleyen Ben Olduklarım" name="my_tagged_partners" domain="[('etiketleyen_id', '=', uid)]"/>
                <separator/>
            </xpath>

            <xpath expr="//group" position="inside">
                <filter string="Bölgeye Göre" name="group_by_bolge" context="{'group_by': 'bolge_adi'}"/>
                <filter string="Taraf Durumuna Göre" name="group_by_taraf" context="{'group_by': 'taraf'}"/>
<!--                <filter string="Kuruma Göre" name="group_by_kurum" context="{'group_by': 'kurum_adi'}"/>-->
                <filter string="Sorumlu Personele Göre" name="group_by_sorumlu" context="{'group_by': 'sorumlu_id'}"/>
                <filter string="Etiketleyen Personele Göre" name="group_by_etiketleyen" context="{'group_by': 'etiketleyen_id'}"/>

                <filter string="Rehberinde Olan Personele Göre" name="group_by_rehber" context="{'group_by': 'rehberinde_olan_user_ids'}"/>
            </xpath>

        </field>
    </record>

    <record id="view_partner_pivot_saha" model="ir.ui.view">
        <field name="name">res.partner.pivot.saha</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <pivot string="Saha İstatistikleri" display_quantity="true">

                <field name="bolge_adi" type="row"/>

                <field name="taraf" type="col"/>

                </pivot>
        </field>
    </record>

    <record id="view_partner_graph_saha" model="ir.ui.view">
        <field name="name">res.partner.graph.saha</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <graph string="Saha Analizi" type="bar" stacked="True">
                <field name="taraf" type="row"/>
                <field name="bolge_adi" type="col"/>
            </graph>
        </field>
    </record>
