<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vault_fetch_wizard_form" model="ir.ui.view">
        <field name="name">vault.fetch.wizard.form</field>
        <field name="model">vault.fetch.wizard</field>
        <field name="arch" type="xml">
            <form string="Kasa Sorgulama">
                <field name="is_session_authenticated" invisible="1"/>
                <field name="result_text" invisible="1"/>

                <div invisible="is_session_authenticated or result_text"
                     class="alert alert-info"
                     role="status">
                    <i class="fa fa-info-circle me-1"/> İsimleri görmek için lütfen oturum şifresini giriniz.
                </div>

                <group invisible="is_session_authenticated or result_text">
                    <field name="vault_password" password="1" placeholder="****"/>
                </group>

                <div invisible="not is_session_authenticated or result_text"
                     class="alert alert-success"
                     role="status">
                    <i class="fa fa-check-circle me-1"/> Kasa oturumu doğrulandı. Kayıtları sorgulayabilirsiniz.
                </div>

                <group invisible="not result_text">
                    <field name="result_text" readonly="1" string="Sorgu Sonuçları"/>
                </group>

                <footer>
                    <button name="action_fetch_names" string="Sorgula" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Kapat" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_vault_fetch_names_wizard_binding" model="ir.actions.act_window">
        <field name="name">Kasa'dan İsim Sorgula</field>
        <field name="res_model">vault.fetch.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>